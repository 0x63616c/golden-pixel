# Release lanes. CI runs them (.github/workflows/testflight.yml, asc-setup.yml) with the
# App Store Connect API key in ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT; locally, put the
# same three in fastlane/.env (gitignored). Run from the repo root: `bundle exec fastlane <lane>`.
# Note: inside lanes, `sh` and File paths are relative to this fastlane/ folder.

default_platform(:ios)

BUNDLE_ID = "co.worldwidewebb.goldenpixel"
APP_NAME = "Golden Pixel"
FALLBACK_NAMES = ["Golden Pixel: Idle Breaker", "Golden Pixel - Pixel Breaker"].freeze
SKU = "golden-pixel-001"
GROUP = "Me"

def summary(line)
  UI.message(line)
  path = ENV["GITHUB_STEP_SUMMARY"]
  File.open(path, "a") { |f| f.puts(line) } if path
end

def marketing_version
  File.read(File.expand_path("../ios/project.yml", __dir__))[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
end

# Lanes that write to the App Store listing or submit for review run only with GP_ASC_WRITE=1
# set for that one command, after the user has approved that exact step (the appstore skill
# asks every time). CI never sets it.
def allow_write!(what)
  return if ENV["GP_ASC_WRITE"] == "1"
  UI.user_error!("Refusing to #{what}: it writes to App Store Connect. Rerun with GP_ASC_WRITE=1 once the user has approved it.")
end

# The API key when ASC_KEY_* are set (CI, or locally from 1Password); otherwise, locally, the
# saved Apple ID web session of FASTLANE_USER (fastlane/.env), which needs no password while
# its cookie in ~/.fastlane/spaceship is valid.
private_lane :api_key do
  if ENV["ASC_KEY_ID"].to_s.empty? && !ENV["FASTLANE_USER"].to_s.empty?
    Spaceship::ConnectAPI.login(ENV["FASTLANE_USER"], use_portal: false, use_tunes: true)
  else
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT")
    )
  end
end

# deliver's login: none with the API key (it reads the lane's key), the Apple ID otherwise.
def deliver_auth
  ENV["ASC_KEY_ID"].to_s.empty? && !ENV["FASTLANE_USER"].to_s.empty? ? { username: ENV["FASTLANE_USER"] } : {}
end

# Every archive signed with the API key (CI) makes Xcode create an "Apple Development: Created
# via API" certificate, whose private key is gone with the runner. Apple allows ten, then the
# archive fails with "Your account has reached the maximum number of certificates". So the
# leftovers are revoked before each archive. Certificates made by a person have their name as
# the display name and are never touched.
def revoke_leftover_ci_certificates
  return if ENV["ASC_KEY_PATH"].to_s.empty?
  stale = Spaceship::ConnectAPI::Certificate.all.select do |c|
    c.certificate_type == "DEVELOPMENT" && c.display_name == "Created via API"
  end
  stale.each(&:delete!)
  UI.message("Revoked #{stale.size} leftover CI development certificate(s)") unless stale.empty?
end

# The internal "Me" group gets every build; the account holder is its tester.
def ensure_group(app)
  group = app.get_beta_groups.find { |g| g.name == GROUP }
  unless group
    client = Spaceship::ConnectAPI.client.test_flight_request_client
    group = client.post("v1/betaGroups", {
      data: {
        type: "betaGroups",
        attributes: { name: GROUP, isInternalGroup: true, hasAccessToAllBuilds: true },
        relationships: { app: { data: { type: "apps", id: app.id } } }
      }
    }).to_models.first
    summary("- Created internal TestFlight group `#{GROUP}`")
  end
  begin
    users = Spaceship::ConnectAPI::User.all.select { |u| (Array(u.roles) & ["ACCOUNT_HOLDER", "ADMIN"]).any? }
    users.each do |u|
      email = u.email.to_s.empty? ? u.username : u.email
      next if email.to_s.empty?
      next if Spaceship::ConnectAPI::BetaTester.all(filter: { email: email, betaGroups: group.id }).any?
      existing = Spaceship::ConnectAPI::BetaTester.find(email: email)
      if existing
        group.add_beta_testers(beta_tester_ids: [existing.id])
      else
        Spaceship::ConnectAPI.client.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: email, firstName: u.first_name, lastName: u.last_name }
        )
      end
      summary("- Added an internal tester to `#{GROUP}` (user id #{u.id})")
    end
  rescue StandardError
    # API errors can contain personal data; never print them.
    summary("- Could not sync internal testers (details withheld)")
  end
  group
end

platform :ios do
  desc "Register the bundle ID, find or create the App Store Connect record, and set up TestFlight"
  lane :setup do
    api_key
    summary("## App Store Connect setup")
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if bundle
      summary("- Bundle ID `#{BUNDLE_ID}` already registered")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: "IOS", identifier: BUNDLE_ID)
      summary("- Registered bundle ID `#{BUNDLE_ID}`")
    end
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    unless app
      ([APP_NAME] + FALLBACK_NAMES).each do |name|
        begin
          client = Spaceship::ConnectAPI.client.tunes_request_client
          client.post("v1/apps", {
            data: {
              type: "apps",
              attributes: { name: name, sku: SKU, primaryLocale: "en-US", bundleId: BUNDLE_ID },
              relationships: { bundleId: { data: { type: "bundleIds", id: bundle.id } } }
            }
          })
          app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
          summary("- Created app record `#{name}`") if app
          break if app
        rescue StandardError => e
          status = e.respond_to?(:status) ? e.status : nil
          summary("- Creating `#{name}` with the API key was refused (#{e.class}#{status ? " #{status}" : ""}): #{e.message.to_s[0, 300]}")
          break unless e.message.to_s =~ /name/i
        end
      end
    end
    if app
      summary("- App record: **#{app.name}**, Apple ID `#{app.id}`, SKU `#{app.sku}`")
      ensure_group(app)
    else
      summary("- **No app record yet.** Create it in App Store Connect > Apps > + > New App: name `#{APP_NAME}`, bundle ID `#{BUNDLE_ID}`, SKU `#{SKU}`, en-US. Then rerun this workflow.")
    end
  end

  desc "Archive, upload to TestFlight (internal group gets it automatically)"
  lane :beta do |options|
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app record for #{BUNDLE_ID}: run the ASC setup workflow (docs/ios.md)") unless app
    version = marketing_version
    # Build number = UTC time of the build, YYYYMMDDHHMM (e.g. 202611201445). UTC so it never
    # goes backwards over a DST change; App Store Connect needs it to keep increasing.
    build = Time.now.utc.strftime("%Y%m%d%H%M").to_i
    latest = latest_testflight_build_number(app_identifier: BUNDLE_ID, initial_build_number: 0).to_i
    UI.user_error!("Build #{build} is not above the latest TestFlight build #{latest}; wait a minute and retry") if build <= latest
    revoke_leftover_ci_certificates
    sh("../ios/ios.sh", "archive", build.to_s)
    ipa = Dir[File.expand_path("../ios/build/export/*.ipa", __dir__)].first
    UI.user_error!("No .ipa exported") unless ipa
    upload_to_testflight(
      ipa: ipa,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: options[:changelog] || "Golden Pixel #{version} (#{build})"
    )
    summary("## TestFlight\n- Uploaded **#{version} (#{build})** for `#{BUNDLE_ID}`")
    ensure_group(app)
    File.open(ENV["GITHUB_ENV"], "a") { |f| f.puts("GP_BUILD=#{build}") } if ENV["GITHUB_ENV"]
  end

  desc "Latest TestFlight builds and their processing state"
  lane :status do |options|
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app record") unless app
    wait = options[:wait].to_i
    deadline = Time.now + wait
    loop do
      builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5)
      latest = builds.first
      done = latest && latest.processing_state != "PROCESSING"
      if done || Time.now >= deadline
        summary("## TestFlight builds")
        builds.each { |b| summary("- #{b.app_version} (#{b.version}): #{b.processing_state}, uploaded #{b.uploaded_date}") }
        break
      end
      sleep 30
    end
  end

  # App Store release: docs/release.md and .claude/skills/appstore/SKILL.md. The listing lives in
  # fastlane/metadata, the age rating in app_rating_config.json, screenshots in
  # fastlane/screenshots (generated by `ios/ios.sh appstore`, gitignored). Price is never touched.

  desc "Read-only: live and editable App Store versions, attached build, listing, screenshot sets, builds"
  lane :appstore_status do
    api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app record for #{BUNDLE_ID}") unless app
    ios = Spaceship::ConnectAPI::Platform::IOS
    summary("## App Store status (repo version #{marketing_version})")
    live = app.get_live_app_store_version(platform: ios)
    summary("- Live: #{live ? "#{live.version_string} (#{live.app_store_state})" : "none, this is the first release"}")
    edit = app.get_edit_app_store_version(platform: ios)
    if edit
      summary("- Editable: #{edit.version_string} (#{edit.app_store_state}), build #{edit.build ? edit.build.version : "none attached"}")
      edit.get_app_store_version_localizations.each do |loc|
        sets = loc.get_app_screenshot_sets.map { |s| "#{s.screenshot_display_type} x#{Array(s.app_screenshots).size}" }
        summary("- #{loc.locale}: keywords #{loc.keywords.to_s.length}/100, description #{loc.description.to_s.length} chars, " \
                "screenshots #{sets.empty? ? "none" : sets.join(", ")}")
      end
    else
      summary("- Editable: none (`metadata` creates version #{marketing_version})")
    end
    info = app.fetch_edit_app_info || app.fetch_live_app_info
    if info
      info.get_app_info_localizations.each do |l|
        summary("- #{l.locale}: name `#{l.name}`, subtitle `#{l.subtitle}`, privacy policy URL #{l.privacy_policy_url.to_s.empty? ? "missing" : "set"}")
      end
      rating = begin
        info.fetch_age_rating_declaration
      rescue StandardError
        nil
      end
      summary("- Age rating declaration: #{rating ? "present" : "not readable"}")
    end
    summary("## Latest builds")
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10).each do |b|
      summary("- #{b.app_version} (#{b.version}): #{b.processing_state}#{b.expired ? ", expired" : ""}, uploaded #{b.uploaded_date}")
    end
  end

  desc "WRITE (GP_ASC_WRITE=1): upload fastlane/metadata and the age rating; shots:true also replaces the screenshots"
  lane :metadata do |options|
    allow_write!("upload the App Store listing")
    api_key
    shots = options[:shots].to_s == "true"
    # Review contact details stay out of git: set them in fastlane/.env, or once by hand in App
    # Store Connect (they persist between versions).
    review = {
      first_name: ENV["GP_REVIEW_FIRST_NAME"], last_name: ENV["GP_REVIEW_LAST_NAME"],
      email_address: ENV["GP_REVIEW_EMAIL"], phone_number: ENV["GP_REVIEW_PHONE"]
    }.reject { |_, v| v.to_s.empty? }
    args = {
      app_identifier: BUNDLE_ID,
      app_version: marketing_version,
      skip_binary_upload: true,
      skip_screenshots: !shots,
      overwrite_screenshots: shots,
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),
      app_rating_config_path: File.expand_path("app_rating_config.json", __dir__),
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true # skip deliver's HTML preview prompt; the skill shows the user the diff first
    }
    args[:app_review_information] = review unless review.empty?
    deliver(**args, **deliver_auth)
    summary("## App Store listing\n- Uploaded metadata#{shots ? " and screenshots" : ""} for #{marketing_version}")
  end

  desc "WRITE (GP_ASC_WRITE=1): attach build:<number> to the version and submit it for review (released by hand)"
  lane :release do |options|
    allow_write!("submit for App Store review")
    build = options[:build].to_s
    UI.user_error!("Pass build:<number>: a VALID TestFlight build of #{marketing_version} (see appstore_status)") if build.empty?
    api_key
    deliver(
      **deliver_auth,
      app_identifier: BUNDLE_ID,
      app_version: marketing_version,
      build_number: build,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      # After approval the version waits in "Pending Developer Release" for the user's tap.
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        # The Pixel Operator 8 font is third-party (CC0), so "yes, with the rights to use it".
        content_rights_contains_third_party_content: true
      }
    )
    summary("## App Store review\n- Submitted #{marketing_version} (#{build}) for review, manual release")
  end

  # The iOS 27 creative asset: marketing/assets/appstore-creative-5244x2950.png (made by
  # marketing/tools/make-creative.py), uploaded to the app's asset library once, then placed as
  # the product page header and the search results art on every localization of the version.
  # Placements lock while the version is in review: run this before `release`.
  desc "WRITE (GP_ASC_WRITE=1): upload the creative asset and place it as header + search results art"
  lane :creative do
    allow_write!("upload the App Store creative asset")
    require "net/http"
    api_key
    asc = Spaceship::ConnectAPI.client.tunes_request_client
    get_all = lambda do |path, params = {}|
      out = []
      resp = asc.get(path, params.merge(limit: 200))
      loop do
        out.concat(Array(resp.body["data"]))
        nxt = resp.body.dig("links", "next")
        break unless nxt
        resp = asc.get(nxt.sub(%r{^https://[^/]+/(iris/)?}, ""))
      end
      out
    end
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    file = File.expand_path("../marketing/assets/appstore-creative-5244x2950.png", __dir__)
    UI.user_error!("Run marketing/tools/make-creative.py first") unless File.exist?(file)
    bytes = File.binread(file)
    img = get_all.call("v1/appAssetLibraries/#{app.id}/images").find do |i|
      a = i["attributes"]
      a["category"] == "CREATIVE_ASSETS" && a["fileName"] == File.basename(file) && a["fileSize"] == bytes.bytesize
    end
    unless img
      img = asc.post("v1/appAssetLibraryImages", { data: { type: "appAssetLibraryImages",
        attributes: { fileName: File.basename(file), fileSize: bytes.bytesize, category: "CREATIVE_ASSETS" },
        relationships: { assetLibrary: { data: { type: "appAssetLibraries", id: app.id } } } } }).body["data"]
      Array(img["attributes"]["uploadOperations"]).each do |op|
        uri = URI(op["url"])
        req = Net::HTTP.const_get(op["method"].capitalize).new(uri)
        op["requestHeaders"].each { |h| req[h["name"]] = h["value"] }
        req.body = bytes.byteslice(op["offset"], op["length"])
        Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req).value }
      end
      asc.patch("v1/appAssetLibraryImages/#{img["id"]}", { data: { type: "appAssetLibraryImages", id: img["id"], attributes: { uploaded: true } } })
    end
    UI.success("Creative asset in the library (#{img["id"]})")

    version = asc.get("v1/apps/#{app.id}/appStoreVersions", { "filter[platform]" => "IOS" }).body["data"]
      .find { |v| %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED].include?(v["attributes"]["appStoreState"]) }
    UI.user_error!("No editable App Store version (placements lock in review)") unless version
    types = %w[PRODUCT_PAGE_HEADER_ASSET APP_STORE_SEARCH_RESULTS_ASSET]
    get_all.call("v1/appStoreVersions/#{version["id"]}/appStoreVersionLocalizations").each do |loc|
      locale = loc["attributes"]["locale"]
      placed = Array(asc.get("v1/appStoreVersionLocalizations/#{loc["id"]}/placements", { limit: 200, include: "image" }).body["data"])
        .select { |p| types.include?(p["attributes"]["placementType"]) }
      if placed.size == types.size && placed.all? { |p| p.dig("relationships", "image", "data", "id") == img["id"] }
        UI.success("#{locale}: creative asset already placed")
        next
      end
      placed.each { |p| asc.delete("v1/appAssetLibraryPlacements/#{p["id"]}") }
      types.each do |type|
        asc.post("v1/appAssetLibraryPlacements", { data: { type: "appAssetLibraryPlacements",
          attributes: { placementType: type, placementGroup: "DEFAULT_PROFILE" },
          relationships: {
            appStoreVersionLocalization: { data: { type: "appStoreVersionLocalizations", id: loc["id"] } },
            image: { data: { type: "appAssetLibraryImages", id: img["id"] } }
          } } })
        UI.success("#{locale}: placed as #{type}")
      end
    end
    summary("## App Store creative asset\n- Placed as product page header and search results art")
  end
end
